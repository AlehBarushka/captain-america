# Скопируйте в .env и заполните значениями из Firebase Console → Project settings → Your apps → Web.
# Файл .env не коммитится. Сгенерированный js/firebase-config.js тоже в gitignore.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
